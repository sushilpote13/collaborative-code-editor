MONGODB_URI=replace-with-managed-mongodb-compatible-connection-string
MONGODB_TLS=true
MONGODB_TLS_CA_FILE=
MONGODB_MIGRATION_SOURCE_URI=
MONGODB_MIGRATION_DESTINATION_URI=
MONGODB_MIGRATION_SOURCE_TLS=false
MONGODB_MIGRATION_DESTINATION_TLS=true
MONGODB_MIGRATION_CA_FILE=
JWT_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters
AWS_PROFILE=devloop
S3_BUCKET_NAME=collaborative-java-editor
AWS_REGION=ap-southeast-2

# Amazon Cognito public identifiers. These are safe to expose to the browser
# bundle, but they are not secrets. VITE_COGNITO_CLIENT_ID must be the client id
# Cognito assigned to an app client that exists in this pool; run
# "npm run verify:cognito" to confirm it. The browser signs in with these
# values over the secure remote password (SRP) protocol, so the app client
# needs no secret and must allow the ALLOW_USER_SRP_AUTH flow.
VITE_AWS_REGION=your-cognito-region
VITE_COGNITO_USER_POOL_ID=your-cognito-user-pool-id
VITE_COGNITO_CLIENT_ID=your-cognito-app-client-id

# Amazon Cognito hosted UI domain. Use the exact domain shown under
# Amazon Cognito -> User pools -> your pool -> App integration -> Domain.
# It must be a bare https:// URL with no path.
COGNITO_DOMAIN=https://your-cognito-domain.auth.your-cognito-region.amazoncognito.com

# Backend-only OAuth settings. The callback URL must match an Allowed callback
# URL of the app client exactly, and the sign-out URL must match an Allowed
# sign-out URL.
COGNITO_CALLBACK_URL=http://localhost:5173/
COGNITO_LOGOUT_URL=http://localhost:5173/

# Leave empty when the app client is a public client (no client secret), which
# is the recommended setup because the server holds the code verifier of the
# hosted-UI fallback flow. Set the secret only when the app client was created
# with one.
COGNITO_CLIENT_SECRET=
